# aihub / LLM
AIHUB_BASE_URL=https://your-aihub-endpoint/v1
AIHUB_API_KEY=your_api_key_here
QA_MODEL=gpt-4.1-mini

# Langfuse 监控（可选）
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Trace 在 Langfuse 中显示的名称，可在 .env 中自定义
LANGFUSE_TRACE_NAME=qa-agent-math
MINERU_BASE_URL='https://mineru.net'
MINERU_TOKEN='ey...'

WEB_SEARCH_MIN_SIM=0.40
QA_WEB_SEARCH_REWRITE_QUERY=1

QA_KB_USE_SQLITE=true